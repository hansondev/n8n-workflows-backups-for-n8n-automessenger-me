        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"adgroup_segments\":{\n      \"adgroup_name\":{\n        \"type\": \"array\",\n        \"items\": {\n          \"keyword\": {\n            \"type\": \"string\"\n          },\n          \"competiton_index\": {\n            \"type\": \"number\"\n          },\n          \"competiton_range\": {\n            \"type\": \"string\"\n          },\n          \"avg_search_vol\": {\n            \"type\": \"number\"\n          },\n          \"lowest_cpc\": {\n            \"type\": \"string\"\n          },\n          \"highest_cpc\": {\n            \"type\": \"string\"\n          }                           \n        }\n      }\n    }\n  }\n}"
