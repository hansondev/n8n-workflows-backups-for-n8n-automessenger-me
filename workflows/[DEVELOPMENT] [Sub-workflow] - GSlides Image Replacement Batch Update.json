    {
      "parameters": {
        "method": "POST",
        "url": "=https://slides.googleapis.com/v1/presentations/{{ $('When Executed by Another Workflow').item.json.presentation_id }}:batchUpdate ",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleSlidesOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"requests\": [\n    {\n        \"replaceImage\": {\n          \"imageObjectId\": \"{{ $json.objectId }}\",\n          \"url\": \"{{ $('When Executed by Another Workflow').item.json.client_logo || $('When Executed by Another Workflow').item.json.ad_image }}\",\n          \"imageReplaceMethod\": \"CENTER_CROP\"\n        }\n    },\n    {\n      \"updatePageElementAltText\": {\n        \"objectId\": \"{{ $json.objectId }}\",\n        \"description\": \"{{ $('When Executed by Another Workflow').item.json.clientLogo_key || $('When Executed by Another Workflow').item.json.adImage_key }}\"\n      }\n    }\n  ]\n}  \n   ",
        "options": {}
      },
