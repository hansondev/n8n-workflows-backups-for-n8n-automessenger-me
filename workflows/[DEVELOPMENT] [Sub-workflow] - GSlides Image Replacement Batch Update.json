        "googleSlidesOAuth2Api": {
          "id": "UttAUbRkOySiEVc5",
          "name": "GSlides Acc(boonhong.tan0309@gmail.com)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const clientLogo_key = $('When Executed by Another Workflow').first().json.clientLogo_key;\n\nconst adImage_key = $('When Executed by Another Workflow').first().json.adImage_key;\n\nconst pageElements = $input\n  .all()\n  .flatMap(item => item.json.slides)\n  .flatMap(slide => slide.pageElements.filter(el => el.image && el.description === clientLogo_key || adImage_key));\n\nconst objectIds = pageElements.map(el => ({ objectId: el.objectId }));\n\nreturn objectIds"
      },
