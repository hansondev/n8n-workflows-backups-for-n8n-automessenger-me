        "json": {
          "output": {
            "companyBackground": "ReadyCare Manufacturing Sdn Bhd is a prominent Malaysian manufacturer based in Ipoh, Perak, specializing in dehumidifiers and household products. Founded by Yeoh Eng Foo in 2013 (with roots back to Comebest (M) Sdn. Bhd.), the company started commercial production in 2014. It is known for innovative home solutions including models of dehumidifiers with integrated fragrances such as charcoal, floral, and lavender. ReadyCare also manufactures environmentally friendly cleaning agents and protective gloves. The company emphasizes quality, safety, and sustainability in its products and operations, incorporating green energy and environmentally conscious practices.",
            "brandOverview": "Readycare Signature is a pioneering Malaysian brand focusing on sustainable, bio-based cleaning solutions crafted from renewable plant-based materials. The brand promotes a bio-based lifestyle to reduce environmental impact, offering products like multipurpose cleaners, dishwashing liquids, and vegan-certified baby care items. It leverages Industry 4.0 technologies and green energy in manufacturing, supporting local communities and economy. Readycare Signature's cleaning products are gentle, free from harsh chemicals, artificial fragrances, and dyes, designed for families including babies and pets, while maintaining high cleaning efficacy.",
            "brandProducts": [
              {
                "productName": "Biobased Baby Laundry Detergent",
                "productDescription": "A plant-based baby laundry detergent that is gentle on the skin and effective in cleaning baby clothes, made from renewable, sustainable materials."
              },
              {
                "productName": "Biobased Baby Bottle & Utensil Cleaner",
                "productDescription": "A gentle yet powerful cleaner designed specifically for baby bottles and utensils, made with plant-based ingredients for safe cleaning."
              },
              {
                "productName": "Biobased Toilet Bowl Cleaner",
                "productDescription": "A toilet bowl cleaner formulated with bio-based ingredients, providing effective cleaning while being environmentally friendly."
              },
              {
                "productName": "Cat & Dog Biobased Pet Deodorant",
                "productDescription": "A pet deodorant for cats and dogs made from bio-based materials, keeping pets fresh with safe and natural ingredients."
              },
              {
                "productName": "Cat Biobased Pet Shampoo",
                "productDescription": "A bio-based shampoo specially formulated for cats, gentle on fur and skin, with natural ingredients to clean and refresh."
              },
              {
                "productName": "Dog Biobased Pet Shampoo",
                "productDescription": "A dog shampoo made from bio-based ingredients, designed for flea and tick protection while being gentle and eco-friendly."
              },
              {
                "productName": "Biobased Glass Cleaner",
                "productDescription": "An eco-friendly glass cleaner made with plant-derived ingredients, providing streak-free and powerful cleaning."
