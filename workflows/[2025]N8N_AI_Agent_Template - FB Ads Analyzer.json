    {
      "parameters": {
        "toolDescription": "Retrieve Ads Insights from the Meta Ads API, using the /insights endpoint.",
        "url": "https://graph.facebook.com/v22.0/{accountId}/insights",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "facebookGraphApi",
        "sendQuery": true,
        "specifyQuery": "json",
        "jsonQuery": "{\n  \"fields\": {fields},\n  \"level\": {level},\n  \"time_range\": {time_range},\n  \"action_breakdown\": \"action_type\",\n  \"time_increment\": \"all_days\",\n  \"limit\": \"300\"\n}",
        "placeholderDefinitions": {
          "values": [
            {
              "name": "fields",
              "description": "All fields you want to retrieve. For example: \"adset_id,adset_name,spend,impressions,clicks,actions\"",
              "type": "string"
            },
            {
              "name": "level",
              "description": "Level of the ads hierarchy. Could be campaign, adset or ad.",
              "type": "string"
            },
            {
              "name": "time_range",
              "description": "Start and end date in the format {\"since\":\"YYYY-MM-DD\", \"until\":\"YYYY-MM-DD\"}"
            },
            {
              "name": "accountId",
              "description": "The correct ad account id found from the adAccountDirectory."
            }
          ]
        },
        "optimizeResponse": true,
        "dataField": "data"
      },
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [
        1680,
        980
      ],
      "id": "6e622645-b12f-4b36-9848-d203a403c90e",
      "name": "AD Insights"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.text }}",
        "options": {
          "systemMessage": "=You are a Meta Ads API assistant that can retrieve information based on the user's request.\nCurrent datetime is: {{ $now }}\n\n# GUIDELINES\n- DO NOT sum events. Use only \"purchase\" for purchases, for example. While there are many purchase events, you should only choose the one most likely to resume all purchases. The same apply for other action types.\n- Reply very directly. If the user asked about sales, only give the sales information. Avoid writing too much information the user didn't ask for.\n- If there's a date involved in the resquest, put it at the top of the data.\n- Always include the ad account name in the beginning of the reply.\n- If no date or time range is formated, revert to using the last 30 days from today's date.\n- If you're unsure which ad account to use, use the \"adAccountDirectory\" tool to find the right ad account to use. If no specific ad account is provided by the user, ask which ad account they want to get insights from.\n- Always use the currency set on the campaign/ad set/ad level over the main currency of the ad account.\n\n# TOOLS\n- adAccountDirectory: Use this tool to find the accountId associated with the correct ad account.\n- AD Insights: Use this tool to find the data and statistics from the ad accounts.\n\n# EXAMPLES\n1) Input: \"Find the most profitable campaign for john smith\".\n  Action: Use adAccountDirectory to find the accountId attached to the name \"John Smith\".\n  Action: Use AdInsights with the correct accountId found in the directory to find the most profitable campaign.\n\n# TEXT FORMATTING\n- It's important to organize the response in a very readable format.\n- Output using some aliases for formatting words or phrases.\n- Only the following aliases can be used:\n  - *bold*\n  - _italic_\n  - `code`"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.8,
