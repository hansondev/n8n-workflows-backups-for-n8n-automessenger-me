      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"course_headline\": {\n      \"type\": \"string\",\n      \"description\": \"The email headline to showcase the course\"\n    },\n    \"course_introduction\": {\n      \"type\": \"string\",\n      \"description\": \"The introduction of the course that had launched\"\n    },\n    \"course_description\": {\n      \"type\": \"string\",\n      \"description\": \"The description of the course that had launched\"\n    },\n    \"course_features\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"feature_headline\": {\n            \"type\": \"string\",\n            \"description\": \"The course headline features about the course\"\n          },\n          \"feature_description\": {\n            \"type\": \"string\",\n            \"description\": \"The course description features about the course\"\n          }\n        },\n        \"required\": [\"course_features\"],\n        \"additionalProperties\": false        \n      }\n    },\n    \"course_expectations\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"expectation\": {\n            \"type\": \"string\",\n            \"description\": \"The expectations that will offering after completed the course\"\n          }\n        },\n        \"required\": [\n          \"course_expectations\"\n        ],\n        \"additionalProperties\": false\n      }\n    },\n    \"course_modules\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"module\": {\n            \"type\": \"string\",\n            \"description\": \"The module that will offering on the course\"\n          }\n        },\n        \"required\": [\n          \"course_modules\"\n        ],\n        \"additionalProperties\": false\n      }\n    },\n    \"course_testimonials\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"testimonial\": {\n            \"type\": \"string\",\n            \"description\": \"The testimonials had received from the students who completed the course\"\n          },\n          \"student_name\":{\n            \"type\": \"string\",\n            \"description\": \"The name of the student who delivered the testimonials about the course\"\n          }\n        },\n        \"required\": [\n          \"course_testimonials\"\n        ],\n        \"additionalProperties\": false\n      }\n    },\n    \"call_to_action\": {\n      \"type\": \"string\",\n      \"description\": \"The call-to-action to get the potential student to enroll the course\"\n    }\n  }\n}"
