    },
    {
      "parameters": {
        "jsCode": "const results = [];\n\nconst columns = $input.first().json.cells;\n\n// The first item (i = 0) contains our column headers, that's we start with the second column (i = 1)\nfor (let i = 1; i < $input.all().length; i++) {\n  const cells = $input.all()[i].json.cells;\n  let result = {};\n  \n  // The first colum (ii = 0) is always empty from the looks of it, so we once again start with the second colum (ii = 1)\n  for (let ii = 1; ii < cells.length; ii++) {\n    result[columns[ii]] = cells[ii];\n  }\n\n  results.push(result);\n}\n\nreturn results.map(e => {\n  return {\n    json: e\n  }\n});"
      },
