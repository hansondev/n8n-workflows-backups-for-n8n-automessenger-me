    {
      "parameters": {
        "projectId": {
          "__rl": true,
          "value": "ctn-hanson-n8n-integration",
          "mode": "list",
          "cachedResultName": "ctn-hanson-n8n-integration",
          "cachedResultUrl": "https://console.cloud.google.com/bigquery?project=ctn-hanson-n8n-integration"
        },
        "sqlQuery": "/* GA4BQ query start*/\n\nSELECT\n  parse_date(\"%Y%m%d\", event_date) as `Date`,\n  traffic_source.source as `user_source`,\n  traffic_source.name as `user_campaign`,\n  traffic_source.medium as `user_medium`,\n  COUNT(*)/COUNT(DISTINCT user_pseudo_id) as `Events_per_user`\nFROM\n  `ctn-hanson-n8n-integration.analytics_426212519.events_*`\nWHERE\n  (\n    REGEXP_EXTRACT(_TABLE_SUFFIX, r'[0-9]+') BETWEEN '{{ $json.start_date }}' AND '{{ $json.end_date }}'\n  )\n  AND (\n    (\n      SELECT\n        value.string_value\n      FROM\n        UNNEST (event_params)\n      WHERE\n        key='affiliate_code'\n    )='Y02IB3n2'\n    AND event_name='generate_lead'\n    AND traffic_source.source<>'direct'\n  )\nGROUP BY\n  1,\n  2,\n  3,\n  4\n\n/* GA4BQ query end*/",
        "options": {}
      },
