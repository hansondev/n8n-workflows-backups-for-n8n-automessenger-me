      "typeVersion": 4.2,
      "credentials": {
        "googleAdsOAuth2Api": {
          "id": "yrOcW5H4HverHw3r",
          "name": "GAds(boonhong0309@gmail.com)"
        }
      },
      "notes": "Call the endpoint: \n\nhttps://googleads.googleapis.com/v18/customers/{customer_id}:generateKeywordIdeas \n\nwith your Customer id"
    },
