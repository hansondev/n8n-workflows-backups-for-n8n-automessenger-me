    {
      "parameters": {
        "projectId": {
          "__rl": true,
          "value": "ctn-hanson-n8n-integration",
          "mode": "list",
          "cachedResultName": "ctn-hanson-n8n-integration",
          "cachedResultUrl": "https://console.cloud.google.com/bigquery?project=ctn-hanson-n8n-integration"
        },
        "sqlQuery": "SELECT\n  DATE,\n  event_name,\n  first_user_source,\n  first_user_medium,\n  first_user_campaign_name,\n  device_category,\n  country_cd_1,\n  dateJoined_cd_2,\n  newMember_cd_3,\n  SAFE_DIVIDE(\n    SUM(event_count_without_session_start),\n    COUNT(DISTINCT user_pseudo_id)\n  ) AS events_per_user\nFROM\n  (\n    SELECT\n      event_date AS DATE,\n      event_name AS event_name,\n      traffic_source.source AS first_user_source,\n      traffic_source.medium AS first_user_medium,\n      traffic_source.name AS first_user_campaign_name,\n      device.category AS device_category,\n      (\n        SELECT\n          value.string_value\n        FROM\n          UNNEST (event_params)\n        WHERE\n          KEY = 'country'\n      ) AS country_cd_1,\n      (\n        SELECT\n          value.string_value\n        FROM\n          UNNEST (event_params)\n        WHERE\n          KEY = 'dateJoined'\n      ) AS dateJoined_cd_2,\n      (\n        SELECT\n          value.string_value\n        FROM\n          UNNEST (event_params)\n        WHERE\n          KEY = 'newMember'\n      ) AS newMember_cd_3,\n      COUNTIF(event_name NOT IN ('session_start')) AS event_count_without_session_start,\n      user_pseudo_id\n    FROM\n      `ctn-hanson-n8n-integration.analytics_426212519.events_*`\n    WHERE\n      _TABLE_SUFFIX BETWEEN '20240804' AND '20240831'\n    GROUP BY\n      DATE,\n      event_name,\n      first_user_source,\n      first_user_medium,\n      first_user_campaign_name,\n      device_category,\n      country_cd_1,\n      dateJoined_cd_2,\n      newMember_cd_3,\n      user_pseudo_id\n  )\nGROUP BY\n  DATE,\n  event_name,\n  first_user_source,\n  first_user_medium,\n  first_user_campaign_name,\n  device_category,\n  country_cd_1,\n  dateJoined_cd_2,\n  newMember_cd_3\nHAVING\n  event_name = 'generate_lead'\nORDER BY\n  DATE ASC",
        "options": {}
      },
